# RevivePay Merchant Revenue Recovery Agent
# Environment Configuration

# 1. Razorpay Test API Credentials
# (If missing, agent automatically runs in Simulation Mode using synthetic data)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 2. Email Delivery (Brevo SMTP API)
# (If missing, agent runs in Brevo Simulator Fallback mode)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SENDER_EMAIL=contact@yourdomain.com
SENDER_NAME="RevivePay Merchant Growth Agent"

# 3. Optional Safety & Bounding Cap Overrides
# MAX_DISCOUNT_PERCENT=20
# MAX_BATCH_SPEND_LIMIT=300
# MIN_DAYS_SINCE_LAST_PURCHASE=30
# MAX_OUTREACH_FREQUENCY_DAYS=7
